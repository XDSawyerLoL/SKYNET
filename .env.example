# Main local LLM
SKYNET_OLLAMA_URL=http://127.0.0.1:11434
SKYNET_MODEL=qwen3:8b

# Optional local multimodal model for screenshot analysis, e.g. qwen2.5vl:7b
SKYNET_VISION_MODEL=

# Local state and workspace
SKYNET_DATA_DIR=.skynet
SKYNET_WORKSPACE=workspace
SKYNET_MCP_CONFIG=.skynet/mcp.json
SKYNET_MAX_TOOL_ROUNDS=10
