SKYNET_OLLAMA_URL=http://127.0.0.1:11434
SKYNET_MODEL=qwen3:8b
SKYNET_MODELS=qwen3:8b
SKYNET_VISION_MODEL=
SKYNET_EMBED_MODEL=
SKYNET_DATA_DIR=.skynet
SKYNET_WORKSPACE=workspace
SKYNET_MCP_CONFIG=.skynet/mcp.json
SKYNET_MAX_TOOL_ROUNDS=10
SKYNET_AUTONOMY_POLL_SECONDS=30
SKYNET_SWARM_WORKERS=4

# Optional read-only external skill directories. Separate multiple paths with the OS path separator.
SKYNET_SKILL_DIRS=

# Optional authenticated local channel bridge. Generate your own random token; never commit it.
SKYNET_WEBHOOK_TOKEN=
SKYNET_CHANNEL_HOST=127.0.0.1
SKYNET_CHANNEL_PORT=8765
# Set to 1 only if you explicitly want to bind the channel bridge beyond loopback.
SKYNET_ALLOW_REMOTE_CHANNEL_BIND=0
